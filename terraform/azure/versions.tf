terraform {
  # 1.11 is the floor, not a preference: the database password is passed
  # through write-only arguments and generated by an ephemeral resource, and
  # both exist so that it never lands in state (see database.tf).
  required_version = ">= 1.11"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.40"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.7"
    }
  }
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}

data "azurerm_client_config" "current" {}

locals {
  tags = {
    Project   = "evalgate-rag"
    ManagedBy = "terraform"
  }
}

resource "azurerm_resource_group" "this" {
  name     = "${var.name}-rg"
  location = var.location
  tags     = local.tags
}

# Azure names for Key Vault, PostgreSQL and the OpenAI subdomain are global, so
# a fixed prefix collides with whoever applied this first. The suffix is not a
# secret; it is in state like any other resource name.
resource "random_string" "suffix" {
  length  = 6
  lower   = true
  upper   = false
  numeric = true
  special = false
}

locals {
  unique = "${var.name}-${random_string.suffix.result}"
}

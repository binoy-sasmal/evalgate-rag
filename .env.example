# --- LLM (any OpenAI-compatible endpoint) ---
# Groq free tier: 30 RPM / ~12K TPM / 1K RPD, plus a 100K tokens/day cap.
# LLM__MIN_INTERVAL_S throttles requests to help stay under the TPM cap;
# 429s are retried automatically (honours the `retry-after` header).
# Groq retires hosted models: llama-3.3-70b-versatile was the default until it
# began returning 404 model_not_found. To see what is currently offered:
#   curl -H "Authorization: Bearer $LLM__API_KEY" \
#        https://api.groq.com/openai/v1/models
LLM__BASE_URL=https://api.groq.com/openai/v1
LLM__API_KEY=gsk_...
LLM__MODEL=qwen/qwen3.8-27b
LLM__MIN_INTERVAL_S=2

# --- Embeddings ---
# Groq has no embeddings endpoint, so embeddings always run locally via
# fastembed (BAAI/bge-small-en-v1.5, fixed 384-dim). Re-ingest after
# switching providers — the vector column dimension must match the embedder.
EMBEDDING__PROVIDER=fastembed       # openai | fastembed | hash

# --- Postgres/pgvector (docker compose defaults) ---
DB__HOST=localhost
DB__PORT=5432
DB__USER=rag
DB__PASSWORD=rag
DB__NAME=rag

# --- Langfuse (optional; docker compose --profile tracing) ---
LANGFUSE__ENABLED=false
LANGFUSE__HOST=http://localhost:3000
LANGFUSE__PUBLIC_KEY=pk-lf-...
LANGFUSE__SECRET_KEY=sk-lf-...

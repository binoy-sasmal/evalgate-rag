# --- LLM (any OpenAI-compatible endpoint) ---
# Groq free tier: 30 RPM / ~12K TPM / 1K RPD, plus a 100K tokens/day cap.
# LLM__MIN_INTERVAL_S throttles requests to help stay under the TPM cap;
# 429s are retried automatically (honours the `retry-after` header).
# Groq retires hosted models: llama-3.3-70b-versatile was the default until it
# began returning 404 model_not_found. To see what is currently offered:
#   curl -H "Authorization: Bearer $LLM__API_KEY" \
#        https://api.groq.com/openai/v1/models
LLM__BASE_URL=https://api.groq.com/openai/v1
LLM__API_KEY=gsk_...
LLM__MODEL=qwen/qwen3.8-27b
# api_key (default) | azure_managed_identity (keyless; only works inside Azure,
# see docs/deploy-azure.md)
LLM__AUTH=api_key
LLM__MIN_INTERVAL_S=2
# Declared output ceiling, sent as max_tokens. Providers reserve per-minute
# output budget against a request's *expected* output; with no ceiling Groq
# reserves the model default (2048), which alone exceeds its free-tier 1000
# output-tokens-per-minute cap and 429s every request. Answers run ~30 tokens.
LLM__MAX_TOKENS=512

# --- Embeddings ---
# Groq has no embeddings endpoint, so embeddings always run locally via
# fastembed (BAAI/bge-small-en-v1.5, fixed 384-dim). Re-ingest after
# switching providers — the vector column dimension must match the embedder.
EMBEDDING__PROVIDER=fastembed       # openai | fastembed | hash

# --- Postgres/pgvector (docker compose defaults) ---
DB__HOST=localhost
DB__PORT=5432
DB__USER=rag
DB__PASSWORD=rag
DB__NAME=rag

# --- Langfuse (optional; docker compose --profile tracing) ---
LANGFUSE__ENABLED=false
LANGFUSE__HOST=http://localhost:3000
LANGFUSE__PUBLIC_KEY=pk-lf-...
LANGFUSE__SECRET_KEY=sk-lf-...

# --- OpenTelemetry (optional; docker compose --profile observability) ---
# Traces and metrics over OTLP/HTTP. Leave TELEMETRY__OTLP_ENDPOINT unset to
# use the standard OTEL_EXPORTER_OTLP_* variables a managed collector injects.
TELEMETRY__ENABLED=false
TELEMETRY__OTLP_ENDPOINT=http://localhost:4318

# --- Cross-encoder reranking (optional; off because it did not earn its cost,
# see README "Reranking benchmark") ---
RERANK__ENABLED=false
RERANK__MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK__CANDIDATES=20

# --- Answer-correctness judge (eval only) ---
# A different model family from LLM__MODEL, so it is not grading its own
# family's answers. JUDGE__API_KEY falls back to LLM__API_KEY when unset.
JUDGE__MODEL=openai/gpt-oss-120b
JUDGE__REASONING_EFFORT=low
